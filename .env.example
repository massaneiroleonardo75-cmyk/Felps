# Copie para .env e preencha. Rode com: node --env-file=.env --disable-warning=ExperimentalWarning src/server.js
PORT=3000
BASE_URL=https://seu-dominio.com.br
ADMIN_PASSWORD=troque-esta-senha
NOME_APP=MudaJá

# IA (Claude). Sem isso, o sistema usa o leitor de mensagens por regras.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Janela de ofertas (minutos)
JANELA_IMEDIATO_MIN=10
JANELA_AGENDADO_MIN=60

# WhatsApp: console | meta | evolution
WHATSAPP_PROVIDER=console

# Meta WhatsApp Cloud API (oficial)
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=mudaja-verify

# Evolution API (não-oficial, suporta grupo)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_GRUPO_FRETEIROS=
